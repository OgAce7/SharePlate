# Read by backend/main.py / backend/src/pipeline.py (both use
# os.environ.get, so this only takes effect if you export these
# yourself or load them with something like python-dotenv -- there is
# no automatic .env loading wired up).

# URL of the demand/food-intelligence service (demand_api.py), run as
# a separate `uvicorn demand_api:app --port 8001` process.
SHAREPLATE_API_URL=http://localhost:8001
